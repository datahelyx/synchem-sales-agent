# Copy to .env — every value below is optional. With none of them set, the app
# runs end to end: messages queue in the outbox and meetings use the built-in
# slot picker.

# --- ports ---------------------------------------------------------------
API_PORT=4310
WEB_PORT=5310

# --- locale --------------------------------------------------------------
TZ_NAME=Asia/Karachi

# --- the autonomous half -------------------------------------------------
# Set to "off" to stop the scheduled runs (assignments Mon 09:00, reminders
# every 15 min, follow-ups 08:30). Manual triggers on the Agent page still work.
AGENT_CRON=on

# Reminders are timed against each meeting, not sent as a daily digest.
# Day-before goes to the salesman and the contact; the short one to the
# salesman only, so they know to set off for the visit.
REMIND_DAY_BEFORE_HOURS=24
REMIND_HOURS_BEFORE=2

# --- OUTBOUND SAFETY (read this before adding any credentials) -----------
# The imported companies are REAL businesses with real WhatsApp numbers.
# Booking a test meeting produces a real invite addressed to them.
#
#   off        (default) never deliver to company contacts. Messages are saved
#              to the outbox marked "suppressed" so you can read exactly what
#              would have gone out. Retrying the outbox will NOT release them.
#   redirect   BEST FOR TESTING. Messages really are sent, but every one aimed
#              at a company is re-addressed to you with a banner naming the
#              company it was meant for. No customer can be reached.
#   allowlist  deliver only to entries in OUTBOUND_ALLOWLIST.
#   live       deliver to anyone, real customers included.
#
# Messages to your own salesmen (their in-app inbox) are never restricted.
OUTBOUND_MODE=off

# Where redirected email goes. Required when mode=redirect.
# OUTBOUND_REDIRECT_TO=you@example.com

# Where redirected WhatsApp goes — an email inbox cannot receive one, so this
# is separate. Unset means WhatsApp to companies is held, never rerouted.
# OUTBOUND_REDIRECT_PHONE=+923001234567

# Comma-separated E.164 numbers and/or emails. Only used when mode=allowlist.
# OUTBOUND_ALLOWLIST=+923001234567,you@example.com

# --- WhatsApp (Meta Cloud API) -------------------------------------------
# Credentials alone do NOT start delivery to companies — OUTBOUND_MODE gates
# that separately and on purpose. 97.8% of imported companies have no email,
# so this is the only channel that reaches company contacts.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# --- Google Calendar -----------------------------------------------------
# Without these the app still emails .ics invites and offers a one-click
# "Add to Google Calendar" link, which needs no setup at all. With them,
# meetings sync straight onto each salesman's Google Calendar and the slot
# picker reads their real free/busy.
#
# To create them, at https://console.cloud.google.com:
#   1. New project (any name)
#   2. APIs & Services -> Library -> enable "Google Calendar API"
#   3. OAuth consent screen -> External -> fill the basics ->
#      add yourself under "Test users" (no verification needed while testing)
#   4. Credentials -> Create credentials -> OAuth client ID -> Web application
#   5. Authorised redirect URI, exactly:
#         http://localhost:4310/api/google/callback
#   6. Copy the client ID and secret here, then restart the server
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only set this if the app is not on localhost:4310 (it must match Google exactly).
# GOOGLE_REDIRECT_URI=

# --- Calendly ------------------------------------------------------------
# When set, Agent -> Settings can switch scheduling from the built-in picker
# to Calendly. Odoo's calendar replaces this later via the same interface.
# CALENDLY_LINK=https://calendly.com/your-team/sales-visit

# --- invoicing -----------------------------------------------------------
# Fraction, not percent. 0.18 = 18% sales tax added on top of the deal value.
TAX_RATE=0
